<?xml version="1.0" encoding="utf-8"?>
<!--
  自适应图标前景层：两张叠起来的卡片，上面三道「填空条」，
  最后一道用主题蓝标出 —— 就是挖空的意思。
  画布 108x108，内容必须落在中心 72x72（即 18..90）。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 后面那张卡（压暗一点） -->
    <path
        android:fillColor="#3B82F6"
        android:fillAlpha="0.35"
        android:pathData="M35,20 H73 A7,7 0 0 1 80,27 V57 A7,7 0 0 1 73,64 H35 A7,7 0 0 1 28,57 V27 A7,7 0 0 1 35,20 Z" />

    <!-- 前面那张卡 -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M27,36 H65 A7,7 0 0 1 72,43 V73 A7,7 0 0 1 65,80 H27 A7,7 0 0 1 20,73 V43 A7,7 0 0 1 27,36 Z" />

    <!-- 三道填空条（圆头描边 = 胶囊条） -->
    <path
        android:pathData="M30,48.5 H62"
        android:strokeColor="#94A3B8"
        android:strokeWidth="5"
        android:strokeLineCap="round" />
    <path
        android:pathData="M30,58.5 H54"
        android:strokeColor="#94A3B8"
        android:strokeWidth="5"
        android:strokeLineCap="round" />
    <path
        android:pathData="M30,68.5 H46"
        android:strokeColor="#3B82F6"
        android:strokeWidth="5"
        android:strokeLineCap="round" />
</vector>
